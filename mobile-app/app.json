{
  "expo": {
    "name": "Bunk Predictor",
    "slug": "bunk-predictor",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo-side_end.dev.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "dev.sideend.bunkpredictor",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2322a1f0-72c6-4cc6-b992-31805ed916a3"
      }
    }
  }
}
